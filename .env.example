# Copy to .env and fill in real values. Never commit .env.

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=your-server-public-ip

HOST_WEB_PORT=8090
HOST_LIVEKIT_PORT=7890
LIVEKIT_RTC_PORT=7891
LIVEKIT_UDP_PORT=7892

# ── LLM — Groq ────────────────────────────────────────────────────────────────
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=openai/gpt-oss-20b
LLAMA_API_KEY=gsk_your_groq_key_here

# ── STT — Groq Whisper ────────────────────────────────────────────────────────
STT_PROVIDER=groq
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=gsk_your_groq_key_here

# ── TTS — Kokoro (local) ──────────────────────────────────────────────────────
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE=af_nova

# ── News ──────────────────────────────────────────────────────────────────────
NEWSDATA_API_KEY=your_newsdata_key
YOUTUBE_API_KEY=your_youtube_key

# ── Simli ─────────────────────────────────────────────────────────────────────
SIMLI_API_KEY=your_simli_key
SIMLI_FACE_ID=your_simli_face_id
SIMLI_LIVEKIT_URL=wss://your-public-host

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://user:password@cluster.example.net/dbname
MONGODB_DB=genzpublic

WEB_PORT=8080
HF_HOME=/models
